{
  "manifest_version": 3,
  "name": "ScamShield Scanner",
  "version": "1.0.0",
  "description": "Check messages and links for scam patterns without leaving the page. Right-click any selected text to scan it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://scamshield-9ksh.onrender.com/*"
  ]
}
