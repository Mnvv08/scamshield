{
  "manifest_version": 3,
  "name": "ScamShield Scanner",
  "version": "1.1.0",
  "homepage_url": "https://github.com/Mnvv08/scamshield",
  "description": "Right-click text to check for scams, or scan a whole page for suspicious links.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ScamShield: check text or scan this page for scams",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://scamshield-9ksh.onrender.com/*"
  ]
}
